default_platform(:mac)

platform :mac do

  # Local build: builds the release scheme and installs to /Applications.
  # No version bump, no notarization, no GitHub publish.
  # Use this for day-to-day testing of a release binary on your own machine.
  lane :dev do
    project_root = File.expand_path("..", __dir__)
    derived_data = File.join(project_root, "macos/build/DerivedData")
    built_app = File.join(derived_data, "Build/Products/Release/Sol.app")

    sh(
      "xcodebuild", "build",
      "-workspace", File.join(project_root, "macos/sol.xcworkspace"),
      "-scheme", "release",
      "-configuration", "Release",
      "-derivedDataPath", derived_data,
      "-allowProvisioningUpdates",
      "-allowProvisioningDeviceRegistration",
      "CODE_SIGN_IDENTITY=Apple Development",
      "DEVELOPMENT_TEAM=QZD59LTC7C",
      "CODE_SIGN_STYLE=Automatic"
    )

    sh("cp", "-R", built_app, "/Applications/Sol.app")
    sh("open", "/Applications/Sol.app")
  end

  lane :release do

    # check_apple_agreement(
    #   apple_id: "ospfranco@protonmail.com",
    #   password: ENV["FASTLANE_PORTAL_PASSWORD"]
    # )

    Dir.chdir("..") do
      sh("bun", "bump")
    end

    version = get_version_number(xcodeproj: "./macos/sol.xcodeproj")

    path = "/Users/osp/Developer/sol/"
    appFileName = path + "Sol.app"
    zipFileName = path + "releases/" + version + ".zip"
    
    gym(
      scheme: "release",
      configuration: "Release",
      clean: true,
      workspace: "./macos/sol.xcworkspace",
      output_directory: path,
      export_method: "developer-id"
    )

    notarize(
      package: appFileName,
      bundle_id: "com.ospfranco.sol",
      username: "ospfranco@protonmail.com",
      asc_provider: "24CMR7378R"
    )

    zip(
      path: appFileName,
      output_path: zipFileName,
      symlinks: true
    )

    set_github_release(
      repository_name: "ospfranco/sol",
      api_token: ENV["GITHUB_API_TOKEN"],
      tag_name: version,
      is_generate_release_notes: true,
      upload_assets: [zipFileName]
    )

    release_notes = lane_context[SharedValues::SET_GITHUB_RELEASE_JSON]["body"]

    file_url = "https://github.com/ospfranco/sol/releases/download/" + version + "/" + version + ".zip"
    
    
    Dir.chdir("..") do
      sh("./macos/Pods/Sparkle/bin/generate_appcast", "releases")

      sh("./scripts/appcast.js", file_url, version, release_notes)

      Dir.glob("#{path}releases/*.zip").each { |file| File.delete(file) }

      sh("git", "add", ".")
      sh("git", "commit", "-m", version)
      sh("git", "push")
    end

    sh("cp", "-R", appFileName, "/Applications/")

    sh("open", "/Applications/Sol.app")

    sh("pingme", "Sol " + version + " released")
  end
end
